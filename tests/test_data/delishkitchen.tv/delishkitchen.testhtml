ner:a},{id:dF,id_str:dF,lead:"そのまま食卓へどうぞ♪",title:"スキレットで焼くステーキ",description:"スキレットを使ったステーキの焼き方をご紹介。厚みのある鉄でできたスキレットは、むらなく肉に火が通るので、ステーキを焼くのに適した調理道具です。そのまま食卓に出せば、最後まで温か♪キャンプ飯にもいかがでしょうか？肉の美味しさがシンプルに楽しめる味付けです。つぶしたにんにくと一緒に焼いて風味付けをするのもおすすめ！",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F360371681467827218\u002F1.m3u8",poster_url:dG,webp_poster_url:dH},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F360371681467827218\u002F1.mp4",poster_url:dG,webp_poster_url:dH},ingredient_groups:[{recipe_ingredients:[{name:dr},{name:r},{name:K},{name:"牛脂"}]},{recipe_ingredients:[{name:i},{name:"コーン缶"}]},{recipe_ingredients:[{name:Y},{name:m}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a}],previousUpnextRecipeId:f,upnextRecipe:cM},"search-recommend-curations":{list:[],lastQuery:c,hasError:b,requestId:e},search:{pagination:{currentPage:h,hasNext:b,pagePer:k,pageTotalCount:e},list:[],notFound:b},selection:{item:{}},selections:{pagination:{currentPage:h,hasNext:b,pagePer:k,pageTotalCount:e},selections:[]},session:{session:{id:a,loggedIn:b}},sidebar:{},"slide-menu":{isOpened:b},time:{serverUnixTimeMilliseconds:1778318673813,clientUnixTimeMilliseconds:1778318673812},"today-recommend":{date:a,recommend:a},"user-state":{userState:{user:{},payment_state:{}},agreeToUseEmailUpdateState:c},user:{privacyPolicy:{}},web_config:{is_first_view_creative:b},"webtop-announcements":{list:[]},payment:{"gmopg-cancel":{cancel:{order_id:a}},"gmopg-entry":{entry:{entry_url:a,access_id:a,token:a}}}},serverRendered:d,routePath:"\u002Frecipes\u002F221505023320786136",config:{_app:{basePath:"\u002F",assetsPath:"\u002F_nuxt\u002F",cdnURL:a}}}}(null,false,"",true,0,"221505023320786136",3,1,"アスパラ","酒",10,"しょうゆ","塩こしょう",5,"サラダ油","砂糖","料理の基本！","塩","https:\u002F\u002Fimage.delishkitchen.tv\u002Frecipe\u002F221505023320786136\u002F1.jpg?version=174779952