ipes/221505023320786136"><link data-n-head="ssr" rel="preload" href="https://image.delishkitchen.tv/recipe/221505023320786136/1.jpg?version=1747799522&amp;w=920" as="image"><script data-n-head="ssr" type="text/javascript">window.dataLayer = window.dataLayer || [];function gtag() {dataLayer.push(arguments)};gtag("js", new Date())</script><script data-n-head="ssr" type="text/javascript">window.gnshbrequest = window.gnshbrequest || {cmd:[]}; window.gnshbrequest.cmd.push(function(){ window.gnshbrequest.forceInternalRequest(); });</script><script data-n-head="ssr" src="https://cpt.geniee.jp/hb/v1/218537/1765/wrapper.min.js" async></script><script data-n-head="ssr" src="https://securepubads.g.doubleclick.net/tag/js/gpt.js" async></script><script data-n-head="ssr" type="application/ld+json">{"@context":"https://schema.org","@type":"WPHeader","name":"デリッシュキッチン","url":"https://delishkitchen.tv","image":"https://delishkitchen.tv/s/images/logo.png?version=20200603"}</script><script data-n-head="ssr" type="application/ld+json">{"@context":"http://schema.org","@type":"Recipe","name":"おうちにある調味料で！ 牛肉とアスパラの甘辛炒め","description":"アスパラと牛肉をごはんにぴったりな甘辛い味付けでさっと炒めます。そのままごはんに乗せて丼にするのもおすすめです。","keywords":"主菜・おかず, 肉料理, 牛肉, アスパラ, 野菜のおかず, お肉のおかず, 春の旬野菜, 牛薄切り肉・牛こま切れ肉, ごま油, その他の肉料理, しょうゆ","datePublished":"2018-11-07T02:14:42Z","dateModified":"2025-05-21T03:52:02Z","recipeYield":"2人分","recipeIngredient":["牛切り落とし肉 200g","アスパラ 2本(40g)","玉ねぎ 1/4個","酒 大さじ1/2","片栗粉 大さじ1/2","ごま油 大さじ1/2","酒 大さじ1","砂糖 小さじ1","みりん 大さじ1","しょうゆ 大さじ1と1/2"],"recipeInstructions":[{"@type":"HowToStep","text":"アスパラは根元から1〜2cmの硬い部分を切り落とす。根元に近い1/3部分をピーラーでむき、3cm幅の斜め切りにする。玉ねぎは薄切りにする。","url":"https://delishkitchen.tv/recipes/221505023320786136#step-video-1","image":"https://media.delishkitchen.tv/recipe/221505023320786136/steps/1.jpg?version=1747799385","video":{"@type":"VideoObject","contentUrl":"https://media.delishkitchen.tv/recipe/221505023320786136/steps/1.m3u8"}},{"@type":"HowToStep","text":"ボウルに牛肉を入れ、酒、片栗粉を加えて揉み込む。","url":"https://delishkitchen.tv/recipes/221505023320786136#step-video-2","image":"https://media.delishkitchen.tv/recipe/221505023320786136/steps/2.jpg?version=1747799385","video":{"@type":"VideoObject","contentUrl":"https://media.delishkitchen.tv/recipe/221505023320786136/steps/2.m3u8"}},{"@type":"HowToStep","text":"フライパンにごま油を入れて熱し、牛肉を入れて中火で肉の色が変わるまで炒め、アスパラ、玉ねぎを加えて全体に油がまわるまで炒める。","url":"https://delishkitchen.tv/recipes/221505023320786136#step-video-3","image":"https://media.delishkitchen.tv/recipe/221505023320786136/steps/3.jpg?version=1747799385","video":{"@type":"VideoObject","contentUrl":"https://media.delishkitchen.tv/recipe/221505023320786136/steps/3.m3u8"}},{"@type":"HowToStep","text":"アスパラがしんなりとしたら☆を加えて炒め合わせる。","url":"https://delishkitchen.tv/recipes/221505023320786136#step-video-4","image":"https://media.delishkitchen.tv/recipe/221505023320786136/steps/4.jpg?version=1747799385","video":{"@type":"VideoObject","contentUrl":"https://media.delishkitchen.tv/recipe/221505023320786136/steps/4.m3u8"}}],"image":"https://image.delishkitchen.tv/recipe/221505023320786136/1.jpg?version=1747799522&w=920","headline":"「おうちにある調味料で！牛肉とアスパラの甘辛炒め」をレシピ動画で！","nutrition":{"@type":"NutritionInformation","calories":"332kcal","carbohydrateContent":"13g","fatContent":"19.4g","proteinContent":"20g","sugarContent":"12.3g","sodiumContent":"2.1g"},"author":{"@type":"Organization","name":"デリッシュキッチン","url":"https://delishkitchen.tv"},"publisher":{"@type":"Organization","name":"デリッシュキッチン","url":"https://delishkitchen.tv"},"mainEntityOfPage":{"@type":"WebPage","@id":"https://delishkitchen.tv/recipes/221505023320786136"},"recipeCuisine":"Japanese","recipeCategory":"main course","cookTime":"PT1200S","prepTime":"PT0M","totalTime":"PT1200S","video":{"@type":"VideoObject","name":"牛肉とアスパラの甘辛炒め","thumbnail":"https://image.delishkitchen.tv/recipe/221505023320786136/1.jpg?version=1747799522","thumbnailUrl":"https://image.delishkitchen.tv/recipe/221505023320786136/1.jpg?version=1747799522&w=920","contentUrl":"https://media.delishkitchen.tv/recipe/221505023320786136/1.mp4","uploadDate":"2025-05-21T03:52:02Z","description":"アスパラと牛肉をごはんにぴったりな甘辛い味付けでさっと炒めます。そのままごはんに乗せて丼にするのもおすすめです。","author":{"@type":"Organization","name":"デリッシュキッチン","url":"https://delishkitchen.tv"}},"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.4","reviewCount":346,"bestRating":5,"worstRating":1},"review":[{"@type":"Review","author":{"@type":"Person","name":"えんな"},"datePublished":"2022-02-02T07:53:06Z","reviewBody":"牛肉がお高かったので豚の切り落としで、玉ねぎは小さかったので半分、他はレシピ通りに作りました！美味しかったです！レシピの写真で玉ねぎが糸こんにゃくに見えたので入ってるのかと思ってました(笑)入れても良さげな気がします。","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}},{"@type":"Review","author":{"@type":"Person","name":"ふわもこ"},"datePublished":"2021-07-02T04:25:12Z","reviewBody":"牛肩と牛ももの切り落としをミックスして入れました。お肉が少し多かった(約280g)ので、調味料を多め(約1.5倍)に投入。アスパラは細かったので3本。玉ねぎは半分入れました。\n程良く丁度いい味付け具合です。濃すぎず薄すぎず、ご飯が進みました！美味しいです。\n牛肉が好きな人は、いいと思います。辛みを入れてもピリッとして美味しいかもしれません。","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}},{"@type":"Review","author":{"@type":"Person","name":"ゆか"},"datePublished":"2022-05-27T11:40:42Z","reviewBody":"アスパラは肉と同時に入れました！\nめっちゃ簡単でおいしいです✨ \nご飯に合います！","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}},{"@type":"Review","author":{"@type":"Person","name":"なつ"},"datePublished":"2024-05-19T11:59:19Z","reviewBody":"濃い味好きな私にしては、ちょこっとオイスターソースを入れたくなりましたが、家族にはこのままで好評でした!アスパラの食感も良かったです。アスパラと玉ねぎは、牛肉の赤身がまだ見えるくらいで投入しました。\n","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}},{"@type":"Review","author":{"@type":"Person","name":"まり"},"datePublished":"2022-09-19T22:02:36Z","reviewBody":"お弁当に入れました。簡単にできました。美味しかったです。","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}},{"@type":"Review","author":{"@type":"Person","name":"やっちゃん"},"datePublished":"2022-06-18T06:55:14Z","reviewBody":"味付けもわが家好みでした🎵牛肉なので、食べごたえのあるおかずで有り難いです😆\n調味料も家にあるものなので、簡単に出来ました❗\n玉ねぎ🧅も1/4個ではなく、1/2個入れてアスパラガスは4本入れました😊調味料は少し多めに入れて美味しく出来ました😋\nアスパラガスが無かったら違う食材を入れて作ってみようと思います😉","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}},{"@type":"Review","author":{"@type":"Person","name":"こん"},"datePublished":"2021-12-28T11:02:08Z","reviewBody":"ブロッコリーを追加し、かいわれを乗せました。簡単、美味しくできました。","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}},{"@type":"Review","author":{"@type":"Person","name":"chuck0309"},"datePublished":"2024-08-24T11:25:22Z","reviewBody":"美味しい！🐮2倍の分量で作ったので少し水っぽさもありましたが、おいしく、ご飯🍚もガンガン進みます！アスパラ玉ねぎもたっぷり☺️おすすめのメニューです！","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}},{"@type":"Review","author":{"@type":"Person","name":"daisy＊mama"},"datePublished":"2024-04-25T01:08:07Z","reviewBody":"我が家には丁度いい味。簡単で美味しい。","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}},{"@type":"Review","author":{"@type":"Person","name":"ヒロー"},"datePublished":"2022-03-30T14:51:08Z","reviewBody":"アスパラが嫌いな人がいない我が家なので6本くらい使いました\n個人的にはブロッコリーとか入れてもおいしいかな？\nと言った感想\nただ芯は入れないほうがいいかな","reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5,"worstRating":1}}]}</script><script data-n-head="ssr" type="text/javascript" id="mierucajs">
